
#include <stdio.h>
#include <string.h>

int main() {
    char g[200], lhs, rhs[180];
    char alpha[20][50], beta[20][50];
    int i, j, na = 0, nb = 0;

    printf("Enter grammar (e.g. E->E+T|T): ");
    scanf("%199s", g);

    if (g[1] != '-' || g[2] != '>') {
        printf("Invalid grammar format\n");
        return 0;
    }

    lhs = g[0];
    strcpy(rhs, g + 3);

    i = 0;
    while (rhs[i] != '\0') {
        char p[50];
        int len;

        j = i;
        while (rhs[j] != '|' && rhs[j] != '\0')
            j++;

        len = j - i;

        if (len == 0 || len >= 50) {
            printf("Invalid production\n");
            return 0;
        }

        strncpy(p, rhs + i, len);
        p[len] = '\0';

        if (p[0] == lhs)
            strcpy(alpha[na++], p + 1);
        else
            strcpy(beta[nb++], p);

        if (rhs[j] == '\0')
            break;

        i = j + 1;
    }

    if (na == 0) {
        printf("No left recursion found.\n");
        printf("%c->%s\n", lhs, rhs);
        return 0;
    }

    if (nb == 0) {
        printf("Cannot eliminate left recursion: "
               "no beta production.\n");
        return 0;
    }

    printf("After eliminating left recursion:\n");
    printf("%c->", lhs);

    for (i = 0; i < nb; i++) {
        if (i > 0)
            printf("|");
        printf("%s%c'", beta[i], lhs);
    }

    printf("\n%c'->", lhs);

    for (i = 0; i < na; i++) {
        if (i > 0)
            printf("|");
        printf("%s%c'", alpha[i], lhs);
    }

    printf("|#\n");

    return 0;
}
