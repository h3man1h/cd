
%{
#include <stdio.h>

int chars = 0, words = 0;
int lines = 0, blanks = 0;
extern FILE *yyin;
%}

%%
[^ \t\n]+  { words++; chars += yyleng; }
[ \t]      { blanks++; chars++; }
\n         { lines++; chars++; }
.          { chars++; }
%%

int main() {
    yyin = fopen("input.txt", "r");

    if (yyin == NULL) {
        printf("Cannot open input file\n");
        return 1;
    }

    yylex();

    printf("Characters = %d\n", chars);
    printf("Words = %d\n", words);
    printf("Lines = %d\n", lines);
    printf("Blanks = %d\n", blanks);

    fclose(yyin);
    return 0;
}

int yywrap() {
    return 1;
}
